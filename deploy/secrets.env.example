# Copy to /srv/autob2b/secrets.env on the host, then:
#   chown root:root /srv/autob2b/secrets.env
#   chmod 600 /srv/autob2b/secrets.env
# Create that file before the first `docker compose up`.
# Generate a unique password of at least 10 characters.
# Do not reuse a password from an older AutoB2B copy, email, ticket, or chat.
# Only these three keys are accepted. Values are not written to the app log.
# If the password contains spaces or #, wrap it in double quotes.

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
